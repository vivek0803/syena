# Copy to deploy/.env on the server (chmod 600). Never commit it.

SYENA_DOMAIN=syena.example.com          # your domain; DNS A record -> the VPS's static IP
SYENA_ACME_EMAIL=you@example.com         # for Let's Encrypt expiry notices
SYENA_PUBLIC_ORIGIN=https://syena.example.com

POSTGRES_PASSWORD=                       # long random string
BACKUP_PASSPHRASE=                       # long random string; store it somewhere safe OFF the server
SYENA_ENCRYPTION_KEY=                    # docker compose run --rm api syena gen-key

# Zerodha Kite Connect (redirect URL in the Kite developer console: https://<domain>/kite/callback)
SYENA_KITE_API_KEY=
SYENA_KITE_API_SECRET=

# Angel One SmartAPI (read-only holdings)
SYENA_ANGEL_API_KEY=

# Anthropic API (leave empty to run without AI: grammar parser + rule-based reviews still work)
SYENA_ANTHROPIC_API_KEY=

# Telegram: create a bot with @BotFather; your chat ID from @userinfobot
SYENA_TELEGRAM_BOT_TOKEN=
SYENA_TELEGRAM_CHAT_ID=
SYENA_TELEGRAM_WEBHOOK_SECRET=           # random string of letters/digits

SYENA_LOG_LEVEL=INFO
