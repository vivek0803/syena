# Local development: copy to backend/.env. Production uses deploy/.env (see deploy/.env.example).

SYENA_ENV=dev                      # dev | test | prod  (API docs are only served in dev)
SYENA_DATABASE_URL=sqlite:///./syena.db
SYENA_ENCRYPTION_KEY=              # syena gen-key
SYENA_PUBLIC_ORIGIN=http://localhost:5173
SYENA_COOKIE_SECURE=false
SYENA_TRUST_PROXY_HEADERS=false

# Optional in dev; without them the related features show as "not configured"
SYENA_KITE_API_KEY=
SYENA_KITE_API_SECRET=
SYENA_ANGEL_API_KEY=
SYENA_ANTHROPIC_API_KEY=
SYENA_TELEGRAM_BOT_TOKEN=
SYENA_TELEGRAM_CHAT_ID=
SYENA_TELEGRAM_WEBHOOK_SECRET=

SYENA_LOG_LEVEL=INFO
SYENA_LOG_TO_DB=true

# There is deliberately no setting for trading mode. Mode is stored in the DB and
# can only be changed from the authenticated UI (password + TOTP + typing "LIVE").
