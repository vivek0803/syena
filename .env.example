# Copy to backend/.env for local dev. Never commit real values.

SYENA_ENV=dev                      # dev | test | prod  (API docs are only served in dev)
SYENA_DATABASE_URL=sqlite:///./syena.db
# Prod: postgresql+psycopg://syena:<password>@db:5432/syena

# Fernet key for secrets at rest (TOTP seed, broker tokens). Generate: syena gen-key
SYENA_ENCRYPTION_KEY=

SYENA_PUBLIC_ORIGIN=http://localhost:5173   # prod: https://<yourdomain>
SYENA_COOKIE_SECURE=false                   # prod: true
SYENA_TRUST_PROXY_HEADERS=false             # prod (behind Caddy): true

SYENA_SESSION_IDLE_MINUTES=30
SYENA_SESSION_ABSOLUTE_HOURS=12
SYENA_LOGIN_MAX_FAILURES=5
SYENA_LOGIN_LOCKOUT_MINUTES=15
SYENA_LOGIN_IP_RATE_PER_MINUTE=10

SYENA_LOG_LEVEL=INFO
SYENA_LOG_TO_DB=true

# There is deliberately no setting for trading mode. Mode is stored in the DB and
# can only be changed from the authenticated UI (password + TOTP + typing "LIVE").
